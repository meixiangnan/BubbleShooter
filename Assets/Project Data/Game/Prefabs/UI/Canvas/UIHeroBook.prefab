  - heroId: 23
    heroName: "\u6676\u77FF\u9F39"
    heroDescription: "\u5E38\u5E74\u6F5C\u4F0F\u5728\u6C34\u6676\u5730\u9053\u4E0E\u77FF\u6D1E\u4E2D\u7684\u5730\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u62E5\u6709\u6781\u5176\u950B\u5229\u7684\u767D\u8272\u5DE8\u722A\uFF0C\u80CC\u90E8\u8038\u7ACB\u7740\u6676\u83B9\u5254\u900F\u7684\u84DD\u8272\u6C34\u6676\u7C07\uFF0C\u80FD\u591F\u5438\u6536\u5730\u5E95\u7684\u77FF\u7269\u80FD\u91CF\u3002\u6676\u77FF\u9F39\u6027\u683C\u8E0F\u5B9E\u575A\u97E7\uFF0C\u64C5\u957F\u6253\u6D1E\u4E0E\u6316\u6398\u73CD\u7A00\u77FF\u77F3\uFF0C\u80CC\u4E0A\u7684\u6C34\u6676\u5728\u53D7\u5230\u5A01\u80C1\u65F6\u4F1A\u91CA\u653E\u51FA\u7480\u74A8\u7684\u80FD\u91CF\u62A4\u76FE\u3002"
    heroSprite: {fileID: 21300000, guid: 0167370af45a85045b88d7a09bedaf8a, type: 3}
