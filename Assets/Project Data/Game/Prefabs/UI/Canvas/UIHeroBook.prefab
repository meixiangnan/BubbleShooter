    defaultUnlocked: 0
  - heroId: 40
    heroName: "\u7011\u6D41\u725B"
    heroDescription: "\u4F2B\u7ACB\u4E8E\u60AC\u5D16\u5CED\u58C1\u4E0E\u9AD8\u5C71\u7011\u5E03\u65C1\u7684\u51B0\u6C34\u7CFB\u840C\u5BA0\u3002\u5B83\u62AB\u7740\u4E00\u8EAB\u6E56\u84DD\u8272\u4E0E\u96EA\u767D\u8272\u76F8\u95F4\u7684\u539A\u91CD\u6BDB\u53D1\uFF0C\u989D\u524D\u5782\u843D\u7684\u67D4\u8F6F\u957F\u6BDB\u72B9\u5982\u4E00\u56E2\u503E\u6CFB\u800C\u4E0B\u7684\u6E05\u51C9\u7011\u5E03\u6C34\u6D41\u3002\u7011\u6D41\u725B\u6027\u683C\u575A\u6BC5\u6E29\u548C\uFF0C\u80FD\u9A7E\u9A6D\u9AD8\u5C71\u6C34\u6C7D\u4E0E\u51B0\u723D\u4E4B\u529B\uFF0C\u662F\u9AD8\u539F\u9669\u5883\u4E2D\u6700\u53EF\u9760\u7684\u5B88\u62A4\u8005\u3002"
    heroSprite: {fileID: 21300000, guid: b2271d28cd46d1a44bae897415348766, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 2b8dc36783ff1ae4994ca16e4bbc38e8, type: 3}
