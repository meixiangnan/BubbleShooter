  - heroId: 17
    heroName: "\u51B0\u6676\u8D1D\u8D1D\u718A"
    heroDescription: "\u751F\u6D3B\u5728\u6781\u5BD2\u96EA\u5C71\u4E4B\u5DC5\u7684\u53EF\u7231\u840C\u5BA0\u3002\u5B83\u4EEC\u62E5\u6709\u96EA\u767D\u67D4\u8F6F\u7684\u7ED2\u6BDB\uFF0C\u8116\u9888\u540E\u8038\u7ACB\u7740\u5982\u6D77\u8D1D\u822C\u7CBE\u7F8E\u575A\u786C\u7684\u51B0\u6676\u80CC\u7532\u3002\u51B0\u6676\u8D1D\u8D1D\u718A\u6027\u683C\u4E56\u5DE7\u6E29\u548C\uFF0C\u6700\u559C\u6B22\u5728\u96EA\u5730\u4E0A\u6EDA\u6765\u6EDA\u53BB\uFF1B\u906D\u9047\u5371\u9669\u65F6\uFF0C\u5B83\u4EEC\u4F1A\u7F29\u5165\u575A\u56FA\u7684\u51B0\u6676\u80CC\u7532\u4E2D\uFF0C\u5F62\u6210\u4E00\u9053\u575A\u4E0D\u53EF\u6467\u7684\u9632\u7EBF\u3002"
