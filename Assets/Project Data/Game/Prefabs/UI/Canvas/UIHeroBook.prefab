  - heroId: 25
    heroName: "\u6708\u591C\u6C34\u6BCD"
    heroDescription: "\u53EA\u5728\u6EE1\u6708\u4E4B\u591C\u6D6E\u51FA\u6C34\u9762\u3001\u6F02\u6D6E\u4E8E\u6D77\u6E7E\u4E0A\u7A7A\u7684\u795E\u79D8\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u62E5\u6709\u6DF1\u7D2B\u8272\u7684\u4F1E\u72B6\u8EAF\u4F53\u4E0E\u6CE2\u6D6A\u72B6\u7684\u91D1\u8FB9\uFF0C\u9762\u90E8\u4E2D\u592E\u957F\u7740\u4E00\u53EA\u5DE8\u5927\u7684\u9EC4\u8272\u72EC\u773C\u3002\u6708\u591C\u6C34\u6BCD\u6027\u683C\u795E\u79D8\u800C\u7565\u5E26\u8B66\u60D5\uFF0C\u80FD\u501F\u52A9\u6708\u5149\u6F02\u6D6E\u5E76\u91CA\u653E\u51FA\u5FAE\u5F31\u7684\u7535\u78C1\u6CE2\uFF0C\u8BF1\u5BFC\u6216\u56F0\u4F4F\u63A5\u8FD1\u7684\u654C\u4EBA\u3002"
    heroSprite: {fileID: 21300000, guid: 58a333a546b0193408a3187d85b48f24, type: 3}
