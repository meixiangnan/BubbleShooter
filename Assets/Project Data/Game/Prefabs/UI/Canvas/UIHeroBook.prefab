  - heroId: 24
    heroName: "\u8611\u86E4"
    heroDescription: "\u6816\u606F\u5728\u6E7F\u6DA6\u82D4\u85D3\u4E0E\u5DE8\u578B\u8611\u83C7\u6797\u4E2D\u7684\u6C34\u6728\u53CC\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u7684\u5934\u9876\u9876\u7740\u4E00\u9876\u9C9C\u8273\u7684\u9EC4\u5E95\u767D\u70B9\u8611\u83C7\u5E3D\uFF0C\u809A\u5B50\u4E0A\u6709\u8349\u6728\u56FE\u6848\u7684\u5370\u8BB0\uFF0C\u773C\u795E\u603B\u662F\u663E\u5F97\u6709\u4E9B\u51B7\u6F20\u4E0E\u9AD8\u50B2\u3002\u8611\u86E4\u6027\u683C\u6C89\u7A33\u6DE1\u5B9A\uFF0C\u80FD\u591F\u4ECE\u5934\u9876\u7684\u8611\u83C7\u5E3D\u4E2D\u55B7\u6D12\u51FA\u5E26\u6709\u5404\u79CD\u6548\u679C\u7684\u5B62\u5B50\u96FE\u6C14\u3002"
    heroSprite: {fileID: 21300000, guid: a65c5249d0a4a1444bc71595b566b1ca, type: 3}
