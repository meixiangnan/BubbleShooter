  - heroId: 41
    heroName: "\u751C\u6A59\u718A"
    heroDescription: "\u751F\u6D3B\u5728\u679C\u5B9E\u7D2F\u7D2F\u7684\u6696\u9633\u67D1\u6A58\u6797\u4E2D\u7684\u8349\u6728/\u81EA\u7136\u7CFB\u840C\u5BA0\u3002\u5B83\u6709\u7740\u6A58\u7EA2\u8272\u7684\u6E29\u6696\u7ED2\u6BDB\u4E0E\u5706\u6EDA\u6EDA\u7684\u8EAB\u8EAF\uFF0C\u5934\u9876\u957F\u7740\u51E0\u7247\u65B0\u9C9C\u7684\u7EFF\u8272\u67D1\u6A58\u53F6\u7247\u4E0E\u77ED\u5C0F\u7684\u679C\u8482\u3002\u751C\u6A59\u718A\u6027\u683C\u61A8\u6001\u53EF\u63AC\u3001\u6E29\u548C\u7C98\u4EBA\uFF0C\u9760\u8FD1\u65F6\u80FD\u95FB\u5230\u6E05\u723D\u5B9C\u4EBA\u7684\u6A58\u9999\u3002"
    heroSprite: {fileID: 21300000, guid: d7e3b407e50b32b4d93d028f4bf7a514, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: d4503e6df42f4d64ca897e7e51cadd87, type: 3}
