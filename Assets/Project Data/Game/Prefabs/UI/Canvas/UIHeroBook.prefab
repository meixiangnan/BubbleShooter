  - heroId: 30
    heroName: "\u8C4C\u8C46\u9F99"
    heroDescription: "\u9690\u533F\u4E8E\u8302\u5BC6\u96E8\u6797\u679D\u5E72\u4E0A\u7684\u81EA\u7136\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u901A\u4F53\u5448\u9C9C\u5AE9\u7684\u8349\u7EFF\u8272\uFF0C\u80CC\u90E8\u8038\u7ACB\u7740\u4E00\u8054\u9971\u6EE1\u7684\u8C4C\u8C46\u835A\uFF0C\u5706\u6EDA\u6EDA\u7684\u5927\u773C\u775B\u80FD\u7075\u6D3B\u8F6C\u52A8\u3002\u8C4C\u8C46\u9F99\u6027\u683C\u673A\u654F\u8B66\u60D5\uFF0C\u64C5\u957F\u5229\u7528\u4F53\u8272\u4E0E\u73AF\u5883\u878D\u4E3A\u4E00\u4F53\uFF0C\u5173\u952E\u65F6\u523B\u80FD\u4ECE\u80CC\u90E8\u7684\u8C46\u835A\u4E2D\u5F39\u5C04\u51FA\u575A\u786C\u7684\u201C\u8C4C\u8C46\u70AE\u5F39\u201D\u51FB\u9000\u6765\u72AF\u8005\u3002"
    heroSprite: {fileID: 21300000, guid: e8a57592cc6eaf34782d4ff8191427e4, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: ea54171b886a4234d993f2fde20eedd3, type: 3}
    defaultUnlocked: 0
  - heroId: 31
    heroName: "\u7F57\u5170\u9F99"
    heroDescription: "\u6816\u606F\u4E8E\u795E\u79D8\u7D2B\u7F57\u5170\u82B1\u6D77\u4E2D\u7684\u81EA\u7136\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u62E5\u6709\u901A\u4F53\u7D2B\u7EA2\u8272\u7684\u5A07\u5C0F\u8EAB\u8EAF\uFF0C\u80CC\u90E8\u7C07\u751F\u7740\u6570\u6735\u76DB\u5F00\u7684\u7D2B\u7F57\u5170\u82B1\u6735\u3002\u7F57\u5170\u9F99\u6027\u683C\u6C89\u9759\u5185\u655B\uFF0C\u884C\u8D70\u65F6\u80CC\u4E0A\u7684\u82B1\u6735\u4F1A\u6563\u53D1\u51FA\u5FAE\u5F31\u7684\u7D2B\u8272\u8367\u5149\u4E0E\u8FF7\u4EBA\u82B1\u9999\uFF0C\u80FD\u591F\u5B89\u629A\u5468\u8FB9\u751F\u7269\u7684\u60C5\u7EEA\u3002"
    heroSprite: {fileID: 21300000, guid: fe4d839836dc9ec41b5a5ae386602882, type: 3}
