  - heroId: 45
    heroName: "\u7FE1\u7FE0\u9A6C"
    heroDescription: "\u5954\u8DD1\u4E8E\u6C34\u6676\u5C71\u8C37\u4E0E\u9AD8\u5C71\u7011\u5E03\u8349\u7538\u4E0A\u7684\u5CA9\u77F3/\u81EA\u7136\u7CFB\u840C\u5BA0\u3002\u5B83\u6709\u7740\u901A\u900F\u5982\u7389\u77F3\u822C\u7684\u6DE1\u9752\u8272\u76AE\u6BDB\uFF0C\u9B03\u6BDB\u4E0E\u5C3E\u5DF4\u5747\u7531\u7C07\u751F\u7684\u7FE1\u7FE0\u7ED3\u6676\u6784\u6210\uFF0C\u8EAB\u4E0A\u6563\u53D1\u7740\u70B9\u70B9\u661F\u5149\u3002\u7FE1\u7FE0\u9A6C\u6027\u683C\u9AD8\u8D35\u654F\u6377\uFF0C\u8E44\u4E0B\u80FD\u51DD\u7ED3\u51FA\u5FAE\u5C0F\u7684\u6676\u4F53\uFF0C\u662F\u5C71\u8C37\u4E2D\u7684\u7075\u6C14\u7ED3\u6676\u3002"
