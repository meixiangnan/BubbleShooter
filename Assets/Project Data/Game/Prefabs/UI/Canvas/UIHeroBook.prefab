  m_Name: 
  m_EditorClassIdentifier: 
  returnBtn: {fileID: 4636885601793823118}
  heroGridView: {fileID: 7491997221282314378}
  itemPrefabName: HeroBookItem
  heroDatas:
  - heroId: 1
    heroName: "\u661F\u5C0F\u7075"
    heroDescription: "\u8BDE\u751F\u4E8E\u9065\u8FDC\u661F\u7CFB\u7684\u795E\u79D8\u751F\u7269\uFF0C\u62E5\u6709\u64CD\u63A7\u661F\u8FB0\u4E4B\u529B\u7684\u80FD\u529B\u3002\u5B83\u4EEC\u6027\u683C\u6D3B\u6CFC\u5F00\u6717\uFF0C\u559C\u6B22\u4E0E\u4EBA\u7ED3\u4F34\u3002\u661F\u5C0F\u7075\u7684\u8EAB\u4F53\u5448\u6DF1\u84DD\u8272\uFF0C\u4EFF\u4F5B\u8574\u542B\u7740\u65E0\u5C3D\u7684\u591C\u7A7A\u3002\u5B83\u4EEC\u80FD\u591F\u91CA\u653E\u51FA\u8000\u773C\u7684\u5149\u8292\uFF0C\u4E3A\u8FF7\u5931\u65B9\u5411\u7684\u4EBA\u4EEC\u6307\u5F15\u9053\u8DEF\u3002"
    heroSprite: {fileID: 21300000, guid: 462050d1afdbd72448df26a675ae0117, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: a566b9dafc4a3af40b5991e8617d9d29, type: 3}
    defaultUnlocked: 0
  - heroId: 2
    heroName: "\u5CA9\u7532\u732A"
    heroDescription: "\u751F\u6D3B\u5728\u706B\u5C71\u5730\u5E26\u7684\u575A\u97E7\u751F\u7269\uFF0C\u62E5\u6709\u5CA9\u77F3\u822C\u575A\u786C\u7684\u5916\u58F3\u3002\u5B83\u4EEC\u6027\u683C\u6C89\u7A33\uFF0C\u4E0D\u8F7B\u6613\u52A8\u6012\u3002\u5CA9\u7532\u732A\u4E3B\u8981\u4EE5\u706B\u5C5E\u6027\u77FF\u77F3\u4E3A\u98DF\uFF0C\u8EAB\u4F53\u4E5F\u56E0\u6B64\u8574\u542B\u7740\u5F3A\u5927\u7684\u706B\u5143\u7D20\u529B\u91CF\u3002\u5B83\u4EEC\u64C5\u957F\u5229\u7528\u8EAB\u4F53\u7684\u51B2\u649E\u548C\u5CA9\u77F3\u7A81\u523A\u8FDB\u884C\u653B\u51FB\u3002"
    heroSprite: {fileID: 21300000, guid: 426f038df489101488202c0fc661ab2c, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: a094b58777415e643a947cd4dd0671db, type: 3}
    defaultUnlocked: 0
  - heroId: 3
    heroName: "\u5E7B\u5F71\u8760"
    heroDescription: "\u51FA\u6CA1\u4E8E\u5E7D\u6697\u6D1E\u7A74\u7684\u795E\u79D8\u751F\u7269\uFF0C\u62E5\u6709\u5236\u9020\u5E7B\u8C61\u7684\u80FD\u529B\u3002\u5B83\u4EEC\u6027\u683C\u72E1\u9EE0\uFF0C\u559C\u6B22\u6349\u5F04\u8DEF\u4EBA\u3002\u5E7B\u5F71\u8760\u7684\u8EAB\u4F53\u5448\u7D2B\u8272\uFF0C\u7FC5\u8180\u4E0A\u7ED8\u6709\u795E\u79D8\u7684\u7B26\u6587\u3002\u5B83\u4EEC\u80FD\u591F\u91CA\u653E\u51FA\u5E72\u6270\u654C\u4EBA\u89C6\u7EBF\u7684\u5E7B\u8C61\uFF0C\u5E76\u5728\u6DF7\u4E71\u4E2D\u5BFB\u627E\u653B\u51FB\u673A\u4F1A\u3002"
    heroSprite: {fileID: 21300000, guid: df2d41bfb97a51c498cd60d4c170663b, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 5135f18f8d8f4f64bad2b51816c029d9, type: 3}
    defaultUnlocked: 0
  - heroId: 4
    heroName: "\u6728\u53F6\u5154"
    heroDescription: "\u6816\u606F\u4E8E\u8302\u5BC6\u68EE\u6797\u7684\u6E29\u987A\u751F\u7269\uFF0C\u62E5\u6709\u8F7B\u76C8\u7684\u8EAB\u4F53\u548C\u64CD\u63A7\u690D\u7269\u7684\u80FD\u529B\u3002\u5B83\u4EEC\u6027\u683C\u80C6\u5C0F\uFF0C\u5BB9\u6613\u53D7\u60CA\u3002\u6728\u53F6\u5154\u7684\u7FC5\u8180\u7531\u6811\u53F6\u6784\u6210\uFF0C\u4F7F\u5B83\u4EEC\u80FD\u591F\u5728\u68EE\u6797\u4E2D\u81EA\u7531\u7A7F\u68AD\u3002\u5B83\u4EEC\u80FD\u591F\u53EC\u5524\u85E4\u8513\u7F20\u7ED5\u654C\u4EBA\uFF0C\u6216\u91CA\u653E\u6CBB\u6108\u4E4B\u5149\u3002"
    heroSprite: {fileID: 21300000, guid: 9030dfd0d4b7a6b43aeeea119d199ee1, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 63cd63a753682474f8934ddca5f10b99, type: 3}
    defaultUnlocked: 0
  - heroId: 5
    heroName: "\u8D64\u7130\u86C7"
    heroDescription: "\u8BDE\u751F\u4E8E\u5CA9\u6D46\u4E4B\u4E2D\u7684\u5F3A\u5927\u751F\u7269\uFF0C\u62E5\u6709\u55B7\u5410\u706B\u7130\u548C\u64CD\u63A7\u706B\u5143\u7D20\u7684\u80FD\u529B\u3002\u5B83\u4EEC\u6027\u683C\u66B4\u8E81\uFF0C\u5177\u6709\u5F88\u5F3A\u7684\u653B\u51FB\u6027\u3002\u8D64\u7130\u86C7\u7684\u8EAB\u4F53\u7531\u706B\u7130\u548C\u5CA9\u77F3\u6784\u6210\uFF0C\u6563\u53D1\u7740\u70BD\u70ED\u7684\u9AD8\u6E29\u3002\u5B83\u4EEC\u64C5\u957F\u5229\u7528\u706B\u7130\u55B7\u5410\u548C\u5CA9\u6D46\u7403\u8FDB\u884C\u653B\u51FB\u3002"
    heroSprite: {fileID: 21300000, guid: d80261d39b3dad9408b94c1cdf670eec, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: a9302cc202dfa4e45afe3600dc2877da, type: 3}
    defaultUnlocked: 0
  - heroId: 6
    heroName: "\u95EA\u7535\u7F8A"
    heroDescription: "\u5E38\u5E74\u7A7F\u68AD\u5728\u9633\u5149\u4E18\u9675\u95F4\u7684\u5143\u7D20\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u84EC\u677E\u7684\u7F8A\u6BDB\u5C31\u50CF\u5438\u9971\u4E86\u9759\u7535\u7684\u4E91\u6735\uFF0C\u7D2B\u8272\u7684\u7F8A\u89D2\u548C\u95EA\u7535\u72B6\u7684\u5C3E\u5DF4\u80FD\u84C4\u79EF\u5FAE\u5C0F\u7684\u96F7\u7535\u529B\u91CF\u3002\u867D\u7136\u770B\u4F3C\u6027\u683C\u5192\u5931\u3001\u603B\u7231\u6D3B\u8E66\u4E71\u8DF3\uFF0C\u4F46\u5728\u6218\u6597\u4E2D\u80FD\u7528\u5FAE\u5F31\u7684\u9EBB\u75F9\u7535\u6D41\u4FDD\u62A4\u540C\u4F34\uFF0C\u662F\u961F\u4F0D\u91CC\u7684\u5C0F\u5C0F\u5145\u7535\u5B9D\u3002"
    heroSprite: {fileID: 21300000, guid: ebf08b6401d2c29409584ec3d871027f, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 1defb35aad4e48245abf602bfede213c, type: 3}
    defaultUnlocked: 0
  - heroId: 7
    heroName: "\u6CE1\u6CE1\u516B\u722A"
    heroDescription: "\u751F\u6D3B\u5728\u6E05\u6F88\u6EAA\u6D41\u4E0E\u8377\u5858\u4E2D\u7684\u6C34\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u6027\u683C\u6781\u5176\u597D\u5BA2\u3001\u5929\u771F\u70C2\u6F2B\uFF0C\u6700\u559C\u6B22\u7528\u89E6\u624B\u6413\u51FA\u900F\u660E\u4E14\u4E0D\u6613\u7834\u88C2\u7684\u6C34\u6CE1\u6765\u73A9\u800D\u3002\u6CE1\u6CE1\u516B\u722A\u80FD\u591F\u901A\u8FC7\u6C34\u6CE1\u5305\u88F9\u4F24\u8005\u8FDB\u884C\u6E29\u548C\u7684\u6CBB\u7597\uFF0C\u6216\u8005\u5C06\u654C\u4EBA\u77ED\u6682\u56F0\u5728\u6C34\u6CE1\u9635\u4E2D\u3002"
    heroSprite: {fileID: 21300000, guid: 3047b6a19e7618746af2c148ebfedb3f, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 8917838ee30c134408dd00c82cd70f88, type: 3}
