  - heroId: 27
    heroName: "\u661F\u8292\u72D0"
    heroDescription: "\u6D3B\u8DC3\u4E8E\u7E41\u82B1\u8349\u539F\u7684\u7535\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u7684\u6BDB\u53D1\u5448\u73B0\u660E\u8273\u7684\u9EC4\u7D2B\u4EA4\u7EC7\u8272\u5F69\uFF0C\u5C3E\u5DF4\u672B\u7AEF\u957F\u7740\u4E00\u9897\u60F9\u773C\u7684\u7D2B\u8272\u4E94\u89D2\u661F\u3002\u661F\u8292\u72D0\u6027\u683C\u6D3B\u6CFC\u597D\u52A8\u3001\u597D\u5947\u5FC3\u5F3A\uFF0C\u5954\u8DD1\u65F6\u80FD\u501F\u7531\u5C3E\u5DF4\u91CA\u653E\u51FA\u5FAE\u5F31\u7684\u9759\u7535\u4E0E\u661F\u5149\uFF0C\u5FEB\u901F\u7A7F\u68AD\u4E8E\u82B1\u4E1B\u4E4B\u4E2D\u3002"
