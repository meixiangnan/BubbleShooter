  - heroId: 11
    heroName: "\u7D2B\u7ED2\u4E91\u9E35"
    heroDescription: "\u6816\u606F\u4E8E\u98CE\u4E4B\u82B1\u6D77\u7684\u4F18\u96C5\u840C\u5BA0\u3002\u5B83\u4EEC\u8EAB\u4E0A\u62AB\u7740\u5982\u7D2B\u8272\u68C9\u82B1\u7CD6\u822C\u8F6F\u7CEF\u7684\u7FBD\u6BDB\uFF0C\u5954\u8DD1\u65F6\u811A\u6B65\u6781\u4E3A\u8F7B\u76C8\uFF0C\u4EFF\u4F5B\u8E29\u5728\u4E91\u7AEF\u3002\u7D2B\u7ED2\u4E91\u9E35\u6027\u683C\u6587\u9759\u4F18\u96C5\uFF0C\u975E\u5E38\u6CE8\u91CD\u81EA\u8EAB\u5F62\u8C61\uFF0C\u53D7\u5230\u60CA\u5413\u65F6\u4F1A\u7528\u5FAE\u98CE\u5305\u88F9\u4F4F\u81EA\u5DF1\uFF0C\u5316\u4F5C\u4E00\u9053\u7D2B\u8272\u7684\u75BE\u98CE\u5FEB\u901F\u907F\u5F00\u5371\u9669\u3002"
