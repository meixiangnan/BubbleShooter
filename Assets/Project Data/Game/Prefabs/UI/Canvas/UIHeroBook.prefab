  - heroId: 15
    heroName: "\u62B1\u62B1\u718A"
    heroDescription: "\u751F\u6D3B\u5728\u6708\u5149\u68EE\u6797\u91CC\u7684\u61A8\u539A\u840C\u5BA0\u3002\u5B83\u4EEC\u5168\u8EAB\u957F\u7740\u58A8\u7EFF\u8272\u7684\u67D4\u8F6F\u7ED2\u6BDB\uFF0C\u5934\u9876\u957F\u6709\u53D1\u5149\u7684\u5E7C\u82D7\u89E6\u89D2\uFF0C\u6700\u559C\u6B22\u505A\u7684\u4E8B\u60C5\u5C31\u662F\u53CC\u624B\u7D27\u7D27\u62B1\u7740\u53D1\u5149\u7684\u6E29\u6696\u5357\u74DC\u7761\u89C9\u3002\u62B1\u62B1\u718A\u6027\u683C\u6E29\u548C\u65E0\u5BB3\uFF0C\u6000\u4E2D\u7684\u5357\u74DC\u8574\u542B\u7740\u4E30\u6536\u4E0E\u5927\u5730\u7684\u529B\u91CF\uFF0C\u5728\u5173\u952E\u65F6\u523B\u80FD\u91CA\u653E\u51FA\u8000\u773C\u7684\u6696\u5149\u62B5\u5FA1\u5F3A\u654C\u3002"
