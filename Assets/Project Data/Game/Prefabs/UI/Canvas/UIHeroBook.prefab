  - heroId: 26
    heroName: "\u4E91\u971E\u9E1F"
    heroDescription: "\u7FF1\u7FD4\u4E8E\u5915\u9633\u4E91\u6D77\u4E4B\u4E0A\u7684\u98DE\u884C\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u62E5\u6709\u5982\u91D1\u9EC4\u8272\u7ED2\u7403\u822C\u5706\u6EDA\u6EDA\u7684\u5A07\u5C0F\u8EAF\u5E72\uFF0C\u8EAB\u540E\u6258\u7740\u957F\u957F\u4E14\u534E\u4E3D\u7684\u91D1\u8272\u7FBD\u5C3E\u3002\u4E91\u971E\u9E1F\u6027\u683C\u6B22\u5FEB\u5916\u5411\uFF0C\u6BCF\u5F53\u665A\u971E\u6D12\u6EE1\u5929\u9645\u65F6\uFF0C\u5B83\u4EEC\u4FBF\u4F1A\u5728\u4E91\u7AEF\u76D8\u65CB\u8D77\u821E\uFF0C\u6D12\u4E0B\u5E26\u6709\u6E29\u6696\u5149\u6548\u7684\u70BD\u70ED\u7FBD\u5C51\u3002"
