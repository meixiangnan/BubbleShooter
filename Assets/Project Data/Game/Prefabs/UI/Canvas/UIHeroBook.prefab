  - heroId: 38
    heroName: "\u6811\u8393\u9E2E"
    heroDescription: "\u9690\u533F\u4E8E\u7E41\u8302\u679C\u6728\u6797\u95F4\u7684\u8349\u6728/\u9E1F\u7C7B\u7CFB\u840C\u5BA0\u3002\u5B83\u8EAB\u4E0A\u5305\u88F9\u7740\u5BC6\u5BC6\u9EBB\u9EBB\u3001\u5982\u6210\u719F\u6811\u8393\u822C\u9971\u6EE1\u7EA2\u6DA6\u7684\u7279\u522B\u7FBD\u6BDB\uFF0C\u5C3E\u90E8\u8FD8\u7F00\u7740\u51E0\u7247\u5AE9\u7EFF\u7684\u53F6\u7247\u3002\u6811\u8393\u9E2E\u6027\u683C\u6E29\u987A\u4E56\u5DE7\uFF0C\u4E00\u5BF9\u5706\u6EDA\u6EDA\u7684\u5927\u773C\u775B\u7075\u52A8\u53EF\u7231\uFF0C\u98DE\u8FC7\u679C\u6797\u65F6\u4F1A\u6563\u53D1\u51FA\u6E05\u751C\u7684\u6D46\u679C\u9999\u6C14\u3002"
    heroSprite: {fileID: 21300000, guid: 81331f88a6ab1064b840e29111843522, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 1cb10d94060433642ace252ec4872386, type: 3}
    defaultUnlocked: 0
  - heroId: 39
    heroName: "\u7AF9\u53F6\u957F\u9888\u9F99"
    heroDescription: "\u6E38\u8D70\u4E8E\u5E7D\u9759\u7AF9\u6797\u6DF1\u5904\u7684\u98CE\u6728\u7CFB\u840C\u5BA0\u3002\u5B83\u62E5\u6709\u4FEE\u957F\u4F18\u96C5\u7684\u9888\u90E8\u4E0E\u6DE1\u7EFF\u8272\u7684\u6C34\u5F69\u8D28\u611F\u8EAB\u8EAF\uFF0C\u6700\u5F15\u4EBA\u77A9\u76EE\u7684\u662F\u4E00\u5BF9\u5B9B\u5982\u5A07\u5AE9\u7AF9\u53F6\u822C\u5C55\u5F00\u7684\u5927\u8033\u6735\u548C\u53F6\u7247\u72B6\u7684\u5C3E\u5DF4\u3002\u7AF9\u53F6\u957F\u9888\u9F99\u6027\u683C\u606C\u9759\u4F18\u96C5\uFF0C\u5929\u751F\u80FD\u611F\u77E5\u5FAE\u98CE\u7684\u5F8B\u52A8\uFF0C\u7A7F\u68AD\u4E8E\u7AF9\u6797\u95F4\u65F6\u51E0\u4E4E\u4E0D\u53D1\u51FA\u58F0\u97F3\u3002"
    heroSprite: {fileID: 21300000, guid: b27ce5f9ca6ea5f45aaa8d3f911853be, type: 3}
