  - heroId: 28
    heroName: "\u9999\u8336\u54A9"
    heroDescription: "\u751F\u6D3B\u5728\u9AD8\u5C71\u4E91\u96FE\u8336\u56ED\u4E2D\u7684\u8349\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u8EAB\u4E0A\u62AB\u7740\u5982\u68C9\u82B1\u822C\u8F6F\u7CEF\u7684\u6E29\u6696\u7F8A\u6BDB\uFF0C\u5934\u9876\u957F\u7740\u4E00\u7247\u6E05\u7FE0\u7684\u8336\u53F6\u82BD\u5B62\uFF0C\u773C\u795E\u603B\u662F\u5FAE\u5FAE\u772F\u8D77\uFF0C\u663E\u5F97\u5206\u5916\u5B89\u8BE6\u3002\u9999\u8336\u54A9\u6027\u683C\u6E29\u548C\u6C89\u7A33\uFF0C\u6563\u53D1\u7740\u6DE1\u6DE1\u7684\u6E05\u9999\uFF0C\u80FD\u4E3A\u5468\u56F4\u7684\u540C\u4F34\u6062\u590D\u6D3B\u529B\u4E0E\u5FC3\u795E\u3002"
