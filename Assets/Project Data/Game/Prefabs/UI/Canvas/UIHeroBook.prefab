  - heroId: 14
    heroName: "\u661F\u591C\u6D77\u9A6C"
    heroDescription: "\u53EA\u5728\u9EC4\u660F\u4E0E\u591C\u665A\u4EA4\u754C\u65F6\u73B0\u8EAB\u7684\u5E7B\u517D\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u517C\u5177\u98DE\u9E1F\u7684\u7FBD\u7FFC\u548C\u6D77\u9A6C\u822C\u7684\u5377\u66F2\u5C3E\u5DF4\uFF0C\u6DF1\u7D2B\u8272\u7684\u7FBD\u6BDB\u4E0A\u7F00\u6EE1\u4E86\u5982\u7480\u74A8\u661F\u7A7A\u822C\u7684\u95EA\u5149\u6591\u70B9\u3002\u661F\u591C\u6D77\u9A6C\u6027\u683C\u7075\u52A8\u673A\u654F\uFF0C\u64C5\u957F\u5728\u591C\u8272\u4E2D\u7A7F\u68AD\uFF0C\u80FD\u7528\u661F\u5149\u7EC7\u5C31\u5C4F\u969C\uFF0C\u5E76\u5BF9\u654C\u4EBA\u8FDB\u884C\u72E1\u9EE0\u7684\u7728\u773C\u653B\u51FB\u3002"
