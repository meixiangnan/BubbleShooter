  - heroId: 44
    heroName: "\u8377\u5858\u8D1F"
    heroDescription: "\u6F5C\u4F0F\u4E8E\u7C89\u8377\u6735\u6735\u7684\u9759\u8C27\u6C60\u5858\u8FB9\u7684\u6C34/\u8349\u7CFB\u840C\u5BA0\u3002\u5B83\u6709\u7740\u9752\u7EFF\u8272\u7684\u6676\u83B9\u76AE\u80A4\u4E0E\u5E26\u6709\u6591\u7EB9\u7684\u5C3E\u5DF4\uFF0C\u4E00\u5BF9\u5927\u8033\u6735\u5F62\u4F3C\u5F20\u5F00\u7684\u8377\u53F6\u6247\uFF0C\u80CC\u90E8\u8FD8\u7F00\u7740\u4E00\u6735\u5C0F\u5DE7\u7684\u7C89\u8272\u8377\u82B1\u74E3\u3002\u8377\u5858\u8CA0\u6027\u683C\u6175\u61D2\u60A0\u95F2\uFF0C\u6700\u559C\u6B22\u8DB4\u5728\u6C34\u8FB9\u7684\u6CE5\u5F84\u4E0A\u7761\u5348\u89C9\u3002"
    heroSprite: {fileID: 21300000, guid: 9590c5b73ccbd274e99ec0ac491626fb, type: 3}
