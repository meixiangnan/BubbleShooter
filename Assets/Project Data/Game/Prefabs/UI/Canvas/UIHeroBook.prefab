  - heroId: 36
    heroName: "\u7425\u73C0\u6C34\u6676\u9F9F"
    heroDescription: "\u6816\u606F\u4E8E\u5BCC\u542B\u77FF\u8109\u7684\u6DF1\u5C71\u5CE1\u8C37\u4E2D\u7684\u5CA9\u77F3/\u6C34\u6676\u7CFB\u840C\u5BA0\u3002\u5B83\u7684\u9F9F\u58F3\u4E0A\u751F\u957F\u7740\u6570\u5757\u7480\u74A8\u593A\u76EE\u7684\u91D1\u8272\u7425\u73C0\u6C34\u6676\uFF0C\u53CD\u5C04\u51FA\u6E29\u6696\u800C\u8000\u773C\u7684\u5149\u8292\u3002\u7425\u73C0\u6676\u80CC\u9F9F\u6027\u683C\u7A33\u91CD\u7B03\u5B9E\uFF0C\u79FB\u52A8\u867D\u7136\u7F13\u6162\uFF0C\u4F46\u5176\u80CC\u4E0A\u7684\u6676\u77F3\u80FD\u5438\u6536\u5927\u5730\u5143\u7D20\u80FD\u91CF\uFF0C\u4E3A\u540C\u4F34\u63D0\u4F9B\u575A\u4E0D\u53EF\u6467\u7684\u5149\u80FD\u76FE\u9632\u62A4\u3002"
    heroSprite: {fileID: 21300000, guid: 8fe0dd7f701438546a3bd33503d096eb, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 576fe0a07c615b243bf067ceb8c75453, type: 3}
    defaultUnlocked: 0
  - heroId: 37
    heroName: "\u7389\u9ECD\u80CC\u7532\u9CC4"
    heroDescription: "\u6D3B\u8DC3\u4E8E\u9633\u5149\u8349\u7538\u4E0E\u6D45\u6C34\u6EAA\u6D41\u8FB9\u7684\u81EA\u7136\u7CFB\u840C\u5BA0\u3002\u5B83\u62E5\u6709\u9C9C\u8273\u7684\u4EAE\u9EC4\u8272\u76AE\u80A4\uFF0C\u80CC\u90E8\u6392\u5217\u7740\u5982\u4E00\u6574\u4E32\u9971\u6EE1\u7389\u7C73\u7C92\u822C\u7684\u7279\u5316\u9CDE\u7532\u3002\u7389\u9ECD\u80CC\u7532\u9CC4\u6027\u683C\u60EC\u610F\u4E50\u89C2\uFF0C\u5634\u89D2\u603B\u662F\u6302\u7740\u5FAE\u5C0F\u7684\u81EA\u4FE1\u5F27\u5EA6\uFF0C\u559C\u6B22\u8EBA\u5728\u5CB8\u8FB9\u6652\u592A\u9633\uFF0C\u5438\u6536\u65E5\u5149\u8F6C\u5316\u4E3A\u5145\u6C9B\u7684\u4F53\u529B\u3002"
