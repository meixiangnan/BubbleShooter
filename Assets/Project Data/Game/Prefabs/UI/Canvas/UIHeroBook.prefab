  - heroId: 13
    heroName: "\u7761\u83B2\u9E7F"
    heroDescription: "\u8BDE\u751F\u4E8E\u6DF1\u5C71\u6E05\u6CC9\u4E0E\u6C34\u534E\u4E4B\u5730\u7684\u795E\u5723\u840C\u5BA0\u3002\u5B83\u4EEC\u7684\u8EAB\u4F53\u5B9B\u5982\u6E05\u6F88\u900F\u4EAE\u7684\u6C34\u6D41\u6784\u6210\uFF0C\u6C34\u84DD\u8272\u7684\u6591\u7EB9\u6CDB\u7740\u5FAE\u5149\uFF0C\u6676\u83B9\u7684\u9E7F\u89D2\u4E0A\u76DB\u5F00\u7740\u6C38\u4E0D\u51CB\u96F6\u7684\u7C89\u8272\u7761\u83B2\u3002\u7761\u83B2\u9E7F\u6027\u683C\u6E29\u548C\u5584\u826F\uFF0C\u8E0F\u6C34\u65E0\u75D5\uFF0C\u80FD\u591F\u51C0\u5316\u5468\u906D\u7684\u6C34\u6E90\u4E0E\u8D1F\u9762\u80FD\u91CF\uFF0C\u662F\u68EE\u6797\u4E2D\u5B88\u62A4\u6C34\u8109\u7684\u7CBE\u7075\u3002"
