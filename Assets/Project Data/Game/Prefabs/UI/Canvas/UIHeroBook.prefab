  - heroId: 32
    heroName: "\u6C34\u6CE1\u4F01\u9E45"
    heroDescription: "\u751F\u6D3B\u5728\u6E05\u6F88\u6EAA\u6D41\u4E0E\u7011\u5E03\u65C1\u7684\u51B0\u6C34\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u6709\u7740\u6C34\u84DD\u8272\u4E0E\u767D\u8272\u76F8\u95F4\u7684\u5C0F\u5DE7\u4F53\u578B\uFF0C\u6700\u5947\u7279\u4E4B\u5904\u5728\u4E8E\u4E24\u4FA7\u62CD\u6253\u7684\u7FC5\u8180\u72B9\u5982\u4E24\u7247\u7531\u900F\u660E\u6C34\u6CE1\u51DD\u7ED3\u800C\u6210\u7684\u7FBD\u7FFC\u3002\u6C34\u6CE1\u4F01\u9E45\u6027\u683C\u6B22\u5FEB\u6D3B\u6CFC\uFF0C\u559C\u6B22\u5728\u6C34\u9762\u4E0A\u620F\u6C34\uFF0C\u62CD\u6253\u7FC5\u8180\u65F6\u80FD\u6FC0\u8361\u51FA\u5E26\u6709\u6E05\u51C9\u80FD\u91CF\u7684\u6CE1\u6CE1\u3002"
