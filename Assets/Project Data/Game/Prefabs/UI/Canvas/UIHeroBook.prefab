    defaultUnlocked: 0
  - heroId: 48
    heroName: "\u8349\u8393\u661F\u5929\u86FE"
    heroDescription: "\u6F02\u6D6E\u4E8E\u7C89\u8272\u6D45\u6D77\u4E0E\u73CA\u745A\u7901\u4E0A\u7A7A\u7684\u8349\u6728/\u6C34\u7CFB\u840C\u5BA0\u3002\u5B83\u6709\u7740\u7C89\u7EA2\u8272\u7684\u661F\u5F62\u7FC5\u8180\uFF0C\u4E0A\u9762\u70B9\u7F00\u7740\u5982\u8349\u8393\u7C7D\u822C\u7684\u5C0F\u6591\u70B9\uFF0C\u6838\u5FC3\u662F\u8F6F\u840C\u5A07\u5C0F\u7684\u767D\u5AE9\u8EAB\u4F53\u4E0E\u5C0F\u5DE7\u89E6\u624B\u3002\u8349\u8393\u661F\u5929\u86FE\u6027\u683C\u606C\u9759\u4F18\u96C5\uFF0C\u98DE\u884C\u65F6\u4F1A\u5728\u6D77\u98CE\u4E2D\u6563\u53D1\u51FA\u6DE1\u6DE1\u7684\u6D46\u679C\u6E05\u9999\u3002"
    heroSprite: {fileID: 21300000, guid: ae81874ea0dab204da54fed1bf9d178c, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 8f6773af22fe1d543bc397e6e99816c0, type: 3}
    defaultUnlocked: 0
  - heroId: 49
    heroName: "\u6F29\u6DA1\u7EA2\u72D0"
    heroDescription: "\u7A7F\u68AD\u4E8E\u67AB\u6797\u843D\u53F6\u5C0F\u5F84\u4E0A\u7684\u98CE/\u81EA\u7136\u7CFB\u840C\u5BA0\u3002\u5B83\u62E5\u6709\u91D1\u6A59\u8272\u7684\u987A\u6ED1\u76AE\u6BDB\u4E0E\u7075\u52A8\u7684\u773C\u795E\uFF0C\u6700\u60F9\u773C\u7684\u662F\u90A3\u6761\u5982\u5377\u8F74\u822C\u5B8C\u7F8E\u5377\u66F2\u7684\u6F29\u6DA1\u72B6\u5927\u5C3E\u5DF4\u3002\u6F29\u6DA1\u7EA2\u72D0\u6027\u683C\u673A\u654F\u806A\u6167\u3001\u5E26\u6709\u4E00\u4E1D\u5C0F\u72E1\u9EE0\uFF0C\u8F7B\u8F7B\u7529\u52A8\u5C3E\u5DF4\u4FBF\u80FD\u53EC\u8D77\u4E00\u9635\u5E26\u6709\u67AB\u53F6\u9999\u6C14\u7684\u6696\u98CE\u3002"
    heroSprite: {fileID: 21300000, guid: de5940fab7c28ed429c9b8d0cc595319, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 279afd7580f533b42bb4d5b285b315de, type: 3}
    defaultUnlocked: 0
  - heroId: 50
    heroName: "\u4E91\u5377\u51B0\u6676\u9F99"
    heroDescription: "\u6E38\u8D70\u4E8E\u9AD8\u5C71\u4E91\u6D77\u4E0E\u51B0\u5CF0\u7011\u5E03\u4E4B\u95F4\u7684\u51B0/\u98DE\u884C\u7CFB\u840C\u5BA0\u3002\u5B83\u6709\u7740\u5929\u84DD\u8272\u7684\u6C34\u5F69\u8D28\u611F\u9CDE\u7247\uFF0C\u8EAB\u4F53\u8FB9\u7F18\u4E0E\u80CC\u810A\u5305\u88F9\u7740\u5982\u7965\u4E91\u822C\u7EF5\u8F6F\u4F18\u96C5\u7684\u767D\u4E91\u7ED2\u6BDB\uFF0C\u5934\u9876\u957F\u7740\u5F2F\u66F2\u7684\u6676\u83B9\u51B0\u89D2\u3002\u4E91\u5377\u51B0\u6676\u9F99\u6027\u683C\u9AD8\u8D35\u7965\u548C\uFF0C\u80FD\u5FA1\u4E91\u4E58\u98CE\uFF0C\u5728\u4E91\u96FE\u95F4\u7A7F\u68AD\u81EA\u5982\u3002"
    heroSprite: {fileID: 21300000, guid: ddb39dcb1f4e6ea4991d6b656eda6fb7, type: 3}
