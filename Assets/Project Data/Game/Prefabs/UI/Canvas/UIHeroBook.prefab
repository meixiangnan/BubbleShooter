  - heroId: 35
    heroName: "\u8702\u5C0F\u725B"
    heroDescription: "\u5F98\u5F8A\u4E8E\u5411\u65E5\u8475\u82B1\u6D77\u4E4B\u4E2D\u7684\u53CC\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u517C\u5177\u5C0F\u725B\u7684\u5706\u6DA6\u8EAB\u6750\u4E0E\u871C\u8702\u7684\u6761\u7EB9\u7279\u5F81\uFF0C\u80CC\u4E0A\u957F\u7740\u4E00\u5BF9\u5A07\u5C0F\u900F\u660E\u7684\u7FC5\u8180\uFF0C\u901A\u4F53\u5305\u88F9\u7740\u8F6F\u7CEF\u7684\u9EC4\u68D5\u76F8\u95F4\u6BDB\u53D1\u3002\u8702\u5C0F\u725B\u6027\u683C\u5929\u771F\u70C2\u6F2B\uFF0C\u559C\u6B22\u7A7F\u68AD\u4E8E\u82B1\u6735\u95F4\u91C7\u96C6\u751C\u7F8E\u7684\u82B1\u871C\uFF0C\u662F\u52E4\u52B3\u4E0E\u840C\u8DA3\u7684\u5316\u8EAB\u3002"
