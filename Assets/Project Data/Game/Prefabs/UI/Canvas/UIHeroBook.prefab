  - heroId: 42
    heroName: "\u7BDD\u706B\u58F6"
    heroDescription: "\u6D3B\u8DC3\u4E8E\u591C\u665A\u8425\u5730\u4E0E\u7BDD\u706B\u65C1\u8FB9\u7684\u706B/\u5143\u7D20\u7CFB\u840C\u5BA0\u3002\u5B83\u4EE5\u5706\u6DA6\u7684\u6A59\u7EA2\u8272\u8336\u58F6\u4E3A\u5916\u5F62\uFF0C\u9876\u90E8\u7684\u58F6\u76D6\u4E0A\u71C3\u7740\u4E00\u56E2\u8DF3\u8DC3\u7684\u6E29\u548C\u706B\u7130\uFF0C\u8EAB\u540E\u6709\u7740\u5C0F\u5DE7\u7684\u58F6\u628A\u3002\u7BDD\u706B\u58F6\u6027\u683C\u6D3B\u6CFC\u4FCF\u76AE\uFF0C\u559C\u6B22\u5728\u5BD2\u591C\u91CC\u4E3A\u9732\u8425\u7684\u65C5\u4EBA\u9A71\u6563\u4E25\u5BD2\u3001\u5E26\u6765\u6E29\u6696\u3002"
    heroSprite: {fileID: 21300000, guid: b84b5be8b9f866140a44169929182222, type: 3}
    heroDetailSprite: {fileID: 21300000, guid: 7cbe7fe997a4c0c4584946ea04283ac6, type: 3}
    defaultUnlocked: 0
  - heroId: 43
    heroName: "\u84DD\u7FFC\u8C5A\u9E1F"
    heroDescription: "\u6816\u606F\u4E8E\u70ED\u5E26\u7011\u5E03\u4E0E\u6E05\u6F88\u6C34\u6F6D\u8FB9\u7684\u51B0\u6C34/\u98DE\u884C\u7CFB\u840C\u5BA0\u3002\u5B83\u62E5\u6709\u6C34\u84DD\u8272\u4E0E\u7EAF\u767D\u76F8\u95F4\u7684\u6C34\u6EF4\u72B6\u987A\u6ED1\u8EAB\u4F53\uFF0C\u5934\u90E8\u540E\u65B9\u5EF6\u4F38\u51FA\u7FBD\u7FFC\u822C\u7684\u9CCD\u89D2\uFF0C\u53CC\u81C2\u4F3C\u9CCD\u4F3C\u7FFC\u3002\u84DD\u7FFC\u8C5A\u9E1F\u6027\u683C\u4E56\u5DE7\u597D\u5947\uFF0C\u64C5\u957F\u5728\u6C34\u9762\u4E0E\u4F4E\u7A7A\u6B22\u5FEB\u7A7F\u68AD\uFF0C\u62CD\u6253\u51FA\u6E05\u51C9\u7684\u6C34\u6CE1\u3002"
    heroSprite: {fileID: 21300000, guid: 9aa844f2e922a2540b8f00e21d3574d3, type: 3}
