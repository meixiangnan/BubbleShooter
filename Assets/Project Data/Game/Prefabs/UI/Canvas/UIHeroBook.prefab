    defaultUnlocked: 0
  - heroId: 22
    heroName: "\u96E8\u6797\u9E66"
    heroDescription: "\u6816\u606F\u4E8E\u70ED\u5E26\u96E8\u6797\u6DF1\u5904\u7684\u98DE\u7FD4\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u62E5\u6709\u6E56\u84DD\u8272\u4E0E\u660E\u9EC4\u8272\u4EA4\u7EC7\u7684\u7FBD\u6BDB\uFF0C\u5934\u9876\u957F\u7740\u5982\u82B1\u74E3\u822C\u7684\u7FBD\u51A0\uFF0C\u5DE8\u5927\u7684\u9EC4\u6A59\u8272\u9E1F\u5599\u975E\u5E38\u5438\u775B\u3002\u96E8\u6797\u9E66\u6027\u683C\u5F00\u6717\u5916\u5411\u3001\u5341\u5206\u6D3B\u6CFC\uFF0C\u559C\u6B22\u5728\u6797\u95F4\u7A7F\u68AD\u6B22\u5531\uFF0C\u80FD\u591F\u501F\u52A9\u81EA\u7136\u7684\u6C14\u6D41\u4E3A\u961F\u4F0D\u5E26\u6765\u654F\u6377\u4E0E\u901F\u5EA6\u7684\u63D0\u5347\u3002"
