  - heroId: 29
    heroName: "\u8377\u5858\u6C34\u6BCD"
    heroDescription: "\u6F02\u6D6E\u4E8E\u7C89\u8377\u6C34\u57DF\u4E4B\u4E0A\u7684\u6C34\u7CFB\u840C\u5BA0\u3002\u5B83\u4EEC\u6709\u7740\u6676\u83B9\u5254\u900F\u7684\u6C34\u84DD\u8272\u8EAB\u4F53\uFF0C\u4E0A\u65B9\u957F\u7740\u4E00\u5BF9\u5B9B\u5982\u5154\u5B50\u8033\u6735\u822C\u7684\u900F\u660E\u51F8\u8D77\uFF0C\u4E0B\u8179\u5EF6\u4F38\u51FA\u8F6F\u840C\u7684\u89E6\u624B\u3002\u8377\u5858\u6C34\u6BCD\u6027\u683C\u4E56\u5DE7\u606C\u9759\uFF0C\u559C\u6B22\u5728\u76DB\u5F00\u7684\u8377\u82B1\u95F4\u60A0\u7136\u6F02\u6D6E\uFF0C\u80FD\u6FC0\u8361\u51FA\u5E26\u6709\u6CBB\u6108\u80FD\u91CF\u7684\u5FAE\u5C0F\u6C34\u6CE1\u3002"
    heroSprite: {fileID: 21300000, guid: 028164c83a467b246887e1ee58e52eca, type: 3}
